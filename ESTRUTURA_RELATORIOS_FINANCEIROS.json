{
  "documento": {
    "titulo": "Estrutura de relatórios financeiros para adaptação do FISIA ao ABEL",
    "versao": "1.0",
    "data": "2026-11-01",
    "objetivo": "Mapear páginas, funções, URLs, dados exibidos e lacunas para reproduzir no ABEL a estrutura visual dos relatórios financeiros do FISIA com dados reais do backend ABEL."
  },
  "principio_de_adaptacao": {
    "copiar_do_fisia": [
      "organização visual",
      "navegação por seções",
      "cards de indicadores",
      "agrupamentos por período e paciente",
      "painéis de detalhes"
    ],
    "manter_do_abel": [
      "backend",
      "modelo de dados",
      "autenticação e autorização",
      "auditoria",
      "cálculos financeiros no servidor",
      "exportação auditada"
    ],
    "nao_copiar_do_fisia": [
      "dados mock",
      "localStorage como fonte financeira",
      "datas fixas",
      "agregações limitadas aos últimos 500 registros",
      "fechamento e exportação simulados"
    ]
  },
  "fisia_atual": {
    "relatorio_financeiro_global": {
      "pagina": "/financeiro",
      "fluxo": [
        {
          "ordem": 1,
          "funcao": "loadFinanceiro()",
          "acao": "Carrega lançamentos financeiros e pacientes em paralelo."
        },
        {
          "ordem": 2,
          "urls": [
            "/api/web/financeiro?limit=500",
            "/api/web/pacientes?limit=500"
          ],
          "acao": "Obtém os dados usados pela tela."
        },
        {
          "ordem": 3,
          "funcao": "financeTotals()",
          "acao": "Calcula os indicadores diário e mensal no navegador."
        },
        {
          "ordem": 4,
          "funcao": "renderFinanceiro()",
          "acao": "Monta cards, caixa diário, formas de pagamento e lançamentos."
        }
      ],
      "periodos": {
        "diario": {
          "disponivel": true,
          "parametrizavel": false,
          "referencia": "dia atual do navegador",
          "exibicao": [
            "recebido hoje",
            "quantidade de recebimentos",
            "ticket médio diário",
            "caixa diário"
          ]
        },
        "mensal": {
          "disponivel": true,
          "parametrizavel": false,
          "referencia": "mês atual do navegador",
          "exibicao": [
            "recebido no mês",
            "quantidade de pagamentos",
            "ticket médio mensal",
            "totais por forma de pagamento"
          ]
        },
        "anual": {
          "disponivel": false,
          "observacao": "Não há relatório financeiro anual consolidado no FISIA atual."
        }
      },
      "exportacao": {
        "funcao": "exportFinanceCsv()",
        "formato": "CSV",
        "execucao": "navegador",
        "campos": [
          "data",
          "paciente",
          "tipo",
          "status",
          "valor"
        ]
      },
      "limitacoes": [
        "Máximo de 500 lançamentos retornados pela API.",
        "Cálculos realizados no navegador.",
        "Sem seleção de dia, mês ou ano.",
        "Sem paginação do extrato financeiro."
      ]
    },
    "pagina_geral_de_relatorios": {
      "pagina": "/relatorios",
      "funcao_de_carga": "loadRelatorios()",
      "urls": [
        "/api/web/pacientes?limit=500",
        "/api/web/agenda?limit=500",
        "/api/web/financeiro?limit=500"
      ],
      "funcao_de_agregacao": "buildReportData()",
      "abas": {
        "atendimentos": [
          "total de atendimentos",
          "dias com agenda",
          "atendimentos por dia",
          "atendimentos por serviço"
        ],
        "financeiro": [
          "total recebido",
          "total pendente",
          "total previsto",
          "comparação recebido versus pendente"
        ],
        "pacientes": [
          "atendimentos por paciente",
          "total pago por paciente",
          "total pendente por paciente"
        ]
      },
      "observacao": "As abas não possuem URLs próprias; são controladas pelo estado reportTab."
    },
    "financeiro_v3": {
      "pagina_base": "/financeiro?finance_v3=1",
      "fonte_de_dados": "localStorage e fixtures mock",
      "chave_local": "fisia:finance-v3:mock:v1",
      "secoes": [
        {
          "nome": "visao_geral",
          "url": "/financeiro?finance_v3=1&financeView=overview",
          "exibicao": [
            "recebido no período",
            "a receber",
            "despesas pagas",
            "saldo operacional",
            "fluxo do período",
            "movimentações agrupadas por semana",
            "pendências e conflitos"
          ]
        },
        {
          "nome": "recebimentos",
          "url": "/financeiro?finance_v3=1&financeView=receipts",
          "exibicao": [
            "total recebido",
            "ticket médio",
            "crédito gerado",
            "sincronizações pendentes",
            "recebimentos agrupados por paciente e data"
          ]
        },
        {
          "nome": "cobrancas",
          "url": "/financeiro?finance_v3=1&financeView=charges",
          "exibicao": [
            "em aberto",
            "vencidas",
            "parciais",
            "quitadas",
            "cobranças agrupadas por paciente"
          ]
        },
        {
          "nome": "pacotes_e_creditos",
          "url": "/financeiro?finance_v3=1&financeView=packages",
          "exibicao": [
            "pacotes de sessões",
            "sessões utilizadas e disponíveis",
            "validade",
            "crédito monetário do paciente"
          ]
        },
        {
          "nome": "despesas",
          "url": "/financeiro?finance_v3=1&financeView=expenses",
          "exibicao": [
            "despesas pagas",
            "despesas em aberto",
            "recorrências",
            "categorias e fornecedores"
          ]
        }
      ],
      "acoes_simuladas": [
        "fechamento do dia",
        "exportação CSV",
        "emissão de recibo",
        "demonstrativo"
      ],
      "uso_recomendado": "Referência visual, não fonte de lógica financeira de produção."
    },
    "relatorio_financeiro_individual": {
      "pagina": "/pacientes",
      "entrada": "seleção de um paciente e abertura do painel financeiro",
      "fluxo": [
        {
          "ordem": 1,
          "funcao": "loadSelectedPatientDetails()",
          "acao": "Carrega os dados do paciente selecionado."
        },
        {
          "ordem": 2,
          "url": "/api/web/pacientes/:id/financeiro",
          "acao": "Retorna o histórico financeiro individual."
        },
        {
          "ordem": 3,
          "funcao": "patientFinancePanel()",
          "acao": "Monta os indicadores e o histórico individual."
        },
        {
          "ordem": 4,
          "funcao": "monthlyFinanceDistribution()",
          "acao": "Agrupa os valores por mês para exibição."
        }
      ],
      "secoes": {
        "resumo_consolidado": [
          "total recebido",
          "pagamentos parciais",
          "total em aberto",
          "crédito disponível"
        ],
        "distribuicao_mensal": [
          "valor total por mês",
          "comparação visual entre meses"
        ],
        "historico_detalhado": [
          "data",
          "valor",
          "forma de pagamento",
          "status"
        ]
      },
      "endpoint_de_resumo_disponivel": {
        "url": "/api/web/pacientes/:id/financeiro/resumo",
        "retorno": [
          "total cobrado",
          "total recebido",
          "total pendente",
          "contas abertas",
          "contas pagas",
          "contas parciais",
          "contas isentas",
          "crédito disponível",
          "distribuição mensal",
          "últimos 50 lançamentos"
        ]
      }
    }
  },
