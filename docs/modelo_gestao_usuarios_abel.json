    ],
    "human_access_levels": ["GESTOR", "RECEPCAO", "MEDICO"],
    "statements": [
      "GESTOR has complete operational visibility and exclusive aggregate financial reports with period filters.",
      "Only GESTOR creates users; full name, CPF, date of birth, phone, email and address are mandatory.",
      "A professional user also requires an active CRM or CRP council registration.",
      "RECEPCAO registers patients, maintains administrative data, assigns the doctor and records payment.",
      "MEDICO sees no payment data and only receives paid appointments assigned to that doctor.",
      "Payment is mandatory before medical release; there is no insurance, urgency exception or post-payment flow.",
      "Only GESTOR reverses a payment.",
      "If the assigned professional is absent, there is no attendance, reassignment or substitute professional.",
      "MEDICO uploads the patient PDF from a simple worklist and the accepted upload is already authenticated.",
      "When no PDF can be attached, MEDICO marks Reanalise and provides an operational observation visible to RECEPCAO.",
      "An authenticated PDF enters the reception delivery queue.",
      "RECEPCAO downloads the PDF, manually contacts the patient and records delivery; ABEL does not integrate directly with WhatsApp."
    ],
    "interpretation_notes": [
      "PDF authentication is an atomic result of accepted upload, recording document hash, actor and timestamp; there is no separate finalization step in the user flow.",
      "Reception-created patients are clinic operational records, not records owned by one receptionist.",
      "Reanalysis observation is an operational message for patient contact and must not expose unrestricted clinical notes.",
      "Legacy database fields for insurance, urgency and post-payment will be assessed in a separate database analysis before removal."
    ]
  },
