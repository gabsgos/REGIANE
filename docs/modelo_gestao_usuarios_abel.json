  "resolved_decisions": [
    "Only GESTOR creates users and all required identity/contact/address fields must be present.",
    "Professional registration accepts CRM or CRP and is mandatory for professional users.",
    "Payment is mandatory before medical release; insurance, urgency exception, courtesy/unpaid release and post-payment are not supported.",
    "Only GESTOR reverses payments.",
    "Professional absence means no attendance, reassignment or substitution.",
    "Accepted PDF upload is already authenticated and immediately enters the reception queue.",
    "Payment reversal preserves every authenticated or delivered document and its audit history.",
    "Without PDF, MEDICO marks Reanalise and writes a required operational observation visible to RECEPCAO.",
    "Patient contact and WhatsApp sending are manual reception activities; ABEL has no direct WhatsApp integration.",
    "Only the necessary FISIA authorization primitives will be adapted."
  ],
  "deferred_database_analysis": [
    "Inventory fields related to insurance, urgency, courtesy/unpaid release and post-payment.",
    "Confirm usage, migration impact and retention requirements before removing any legacy field."
  ]
